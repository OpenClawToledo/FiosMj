# cp .env.example .env  e preencha. O .env NUNCA vai para o git.

# Endereço público do site (padrão: https://fiosmj.com). Troque só se usar outro domínio.
SITE_URL=https://fiosmj.com

# Obrigatórios — gere com: openssl rand -hex 32
JWT_SECRET=
# Senha do painel /admin (mínimo 12 caracteres)
ADMIN_SECRET=

# Mercado Pago (pagamentos)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# Newsletter (Brevo) — opcional
BREVO_API_KEY=
BREVO_LIST_ID=0

# Aviso de pedidos por WhatsApp — opcional (vazio = desligado)
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=
MAJU_PHONE=+553399892409
TOLEDO_PHONE=

# Computador em casa: token do Cloudflare Tunnel (Zero Trust → Networks → Tunnels)
# Só é usado com docker-compose.casa.yml ou no celular (deploy/setup-celular.sh)
TUNNEL_TOKEN=
